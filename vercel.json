{
  "installCommand": "pip install -r requirements.txt",
  "buildCommand": "uvicorn main:app",
  "builds": [
    {
      "src": "main.py",
      "use": "@imptype/vercel-python@4.3.35"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {"cache-control": "s-maxage=1000"},
      "dest": "main.py"
    }
  ]
}